# Copy to .env.local and fill in real values. Never commit .env.local.

# MongoDB Atlas Flex connection string (see docs/architecture.md).
MONGODB_URI=

# Optional — database name to connect to. Defaults to "dar_e_arqam".
# Tests use "dar_e_arqam_test" automatically; do not set this yourself
# for local dev unless you want a non-default database name.
MONGODB_DB_NAME=

# Better Auth (see docs/architecture.md — Database and auth).
# BETTER_AUTH_SECRET must be at least 32 characters — generate with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Seeded admin account, consumed by scripts/seed-admin.ts (npm run seed:admin).
# The admin is never exposed as a route; sign-up is disabled.
# ADMIN_PASSWORD must be at least 12 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Cloudinary (admin media uploads; only URLs are stored in the database).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Test-only: set to "skip" to bypass server-side Cloudinary cover-image
# verification (used by Playwright specs that stub the Cloudinary upload
# itself — see playwright.config.ts). Ignored whenever NODE_ENV is
# "production"; leave unset for normal local development.
NEWS_COVER_VERIFY=

# Private document store for CVs (012 careers, ADR-0004/0007).
# Development: leave DOCUMENT_STORE_DRIVER unset (or "local") to keep CVs in a
# gitignored folder outside public/. Production: use "vercel-blob" with a
# PRIVATE Vercel Blob store connected to the project (BLOB_STORE_ID is added
# automatically; BLOB_READ_WRITE_TOKEN is the fallback outside Vercel).
# "local" is refused when NODE_ENV is "production".
DOCUMENT_STORE_DRIVER=
DOCUMENT_STORE_LOCAL_DIR=
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# How many months applications and CVs are kept (1-120). Must be set to the
# client-agreed value before a production build (scripts/check-release-content.ts).
CAREERS_RETENTION_MONTHS=
