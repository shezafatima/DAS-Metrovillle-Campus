# Copy to .env.local and fill in real values. Never commit .env.local.

# MongoDB Atlas Flex connection string (see docs/architecture.md).
MONGODB_URI=

# Better Auth (see docs/architecture.md — Database and auth).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Seeded admin account, consumed by scripts/seed-admin.ts.
# The admin is never exposed as a route; sign-up is disabled.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Cloudinary (admin media uploads; only URLs are stored in the database).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
